{
    "name": "pi-model-banner",
    "version": "26.0.0",
    "description": "Model-specific ANSI startup banner for Pi: Claude, GPT, Gemini, \u2026 each get their own logo, live-updated on model change",
    "keywords": [
        "pi-package",
        "pi-extension",
        "banner",
        "ascii-art",
        "ansi"
    ],
    "license": "MIT",
    "author": "Lennart Luttmann",
    "type": "module",
    "files": [
        "index.ts",
        "content/",
        "lib/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md",
        "NOTICE.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lennart-luttmann/pi-model-banner.git"
    },
    "homepage": "https://github.com/lennart-luttmann/pi-model-banner#readme",
    "bugs": {
        "url": "https://github.com/lennart-luttmann/pi-model-banner/issues"
    },
    "pi": {
        "extensions": [
        	"./index.ts"
        ]
    },
    "scripts": {
        "test": "node scripts/link-pi-deps.mjs && node --test \"tests/*.test.ts\" && python3 scripts/check-logos.py",
        "test:unit": "node --test \"tests/*.test.ts\"",
        "build:logos": "./scripts/build-logos.sh",
        "check:logos": "python3 scripts/check-logos.py",
        "link:deps": "node scripts/link-pi-deps.mjs",
        "preview:logos": "python3 scripts/preview-logos.py"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    }
}
